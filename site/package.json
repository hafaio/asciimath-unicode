{
    "private": true,
    "name": "asciimath-unicode-site",
    "version": "0.0.0",
    "author": "Erik Brinkman <erik.brinkman@gmail.com>",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "fmt": "biome format --write",
        "sync": "svelte-kit sync && bun run --cwd ../extension sync",
        "dev": "bun sync && vite dev",
        "lint": "bun sync && svelte-check --fail-on-warnings && biome check --error-on-warnings",
        "build": "bun sync && vite build",
        "preview": "vite preview"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "asciimath-unicode": "workspace:*",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "vite": "^8.3.2"
    }
}
