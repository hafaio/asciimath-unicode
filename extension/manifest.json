{
    "name": "Ascii Math Unicode",
    "description": "Render ascii math as unicode as you type",
    "version": "4.0.1",
    "options_page": "out/options.html",
    "permissions": ["activeTab", "scripting", "storage"],
    "optional_host_permissions": ["<all_urls>"],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "background": {
        "service_worker": "service_worker.js",
        "type": "module"
    },
    "action": {
        "default_title": "Click to convert ascii math on this page",
        "default_icon": {
            "16": "/images/am-grey16.png",
            "32": "/images/am-grey32.png"
        }
    },
    "commands": {
        "ascii-math-unicode": {
            "suggested_key": {
                "default": "Alt+Shift+U",
                "mac": "MacCtrl+Shift+U"
            },
            "description": "Turn converting ascii math on or off"
        }
    },
    "icons": {
        "16": "/images/am16.png",
        "32": "/images/am32.png",
        "48": "/images/am48.png",
        "128": "/images/am128.png"
    },
    "manifest_version": 3
}
